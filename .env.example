# SmartXFlow Monitor - Environment Variables Template
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun

# ============================================
# SUPABASE AYARLARI (Zorunlu - SmartXFlow backend)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# FIXTURE IDENTITY V2
# ============================================
# Varsayilan false. Yalniz provider-authoritative migration/postflight basariyla
# uygulandiktan sonra release adiminda true yapilir. true iken fixture yazari
# Betwatch provider event ID -> fixture_uid yolunu authoritative kullanir ve
# herhangi bir identity hatasinda legacy hash'e sessiz fallback YAPMAZ.
SMARTXFLOW_FIXTURE_UID_AUTHORITATIVE_WRITE=false

# ============================================
# ARBWORLD COOKIES (Scraper için zorunlu)
# ============================================
# Arbworld'e giriş yaptıktan sonra tarayıcı geliştirici araçlarından alın
ARBWORLD_COOKIES=PHPSESSID=xxx; _ga=xxx; Betfair=shown--

# ============================================
# COOKIE STRING (Alternatif cookie formatı)
# ============================================
COOKIE_STRING=PHPSESSID=xxx; FCNEC=xxx

# ============================================
# SCRAPER KONTROLÜ
# ============================================
# Replit'te scraper devre dışı (EXE kullanılıyor)
DISABLE_SCRAPER=true

# ============================================
# GÜVENLİK
# ============================================
# Flask session secret (rastgele uzun string)
SESSION_SECRET=your-random-secret-key-here

# ============================================
# GITHUB (Opsiyonel - CI/CD ve durable Learning Archive yazımı için)
# ============================================
# Learning Archive icin AYRI repo/token yoktur. Predictor runtime GitHub'a direkt commit
# edecekse mevcut smartxflow repo yazma yetkili normal token kullanilir.
GITHUB_TOKEN=ghp_your_github_token_here

# ============================================
# LEARNING ARCHIVE (Predictor/Development)
# ============================================
# Canonical storage ayni repo icindedir:
#   repository: hazardyk27-sudo/smartxflow
#   data branch: learning-archive
#   root folder: learning_archive_data/
# SMARTXFLOW_LEARNING_ARCHIVE_REPO ve SMARTXFLOW_LEARNING_ARCHIVE_GITHUB_TOKEN KULLANILMAZ.

# SmartXFlow backend ile Learning Archive arasindaki server-to-server gizli anahtar.
# En az 32 rastgele karakter kullan. Degeri kaynak koda veya archive payload'ina yazma.
LEARNING_ARCHIVE_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters

# Learning Archive SXF verisini Supabase'e dogrudan baglanarak okumaz.
# SmartXFlow backend kendi mevcut DB baglantisini kullanir; archive reader bu read-only API'yi cagirir.
# Replit'te REPLIT_DEV_DOMAIN varsa base URL otomatik turetilir. Diger ortamlarda acikca ayarla.
# SMARTXFLOW_LEARNING_API_BASE_URL=https://your-smartxflow-preview-or-production-host
# SMARTXFLOW_LEARNING_API_TOKEN=optional-separate-client-token

# Learning Archive retention holds production migration'i uygulanmistir ve koruma
# varsayilan olarak ACIKTIR. Normal calismada ekstra flag gerekmez.
# Sadece acil durumlarda gecici olarak true yap; false/eksik = retention aktif.
SMARTXFLOW_LEARNING_ARCHIVE_RETENTION_EMERGENCY_DISABLE=false
