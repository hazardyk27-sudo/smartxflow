{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartxflow.local/schemas/learning_archive_match_v1.schema.json",
  "title": "SmartXFlow Learning Archive Match Case v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["archive_schema_version", "case_id", "match", "prediction", "evidence", "settlement", "provenance"],
  "properties": {
    "archive_schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 8},
    "match": {
      "type": "object",
      "required": ["match_id_hash", "league", "home", "away", "kickoff_at"],
      "properties": {
        "match_id_hash": {"type": "string", "minLength": 1},
        "league": {"type": "string", "minLength": 1},
        "home": {"type": "string", "minLength": 1},
        "away": {"type": "string", "minLength": 1},
        "kickoff_at": {"type": "string", "format": "date-time"}
      }
    },
    "prediction": {
      "type": "object",
      "required": ["prediction_at", "decision", "confidence", "rationale", "counterargument"],
      "properties": {
        "prediction_at": {"type": "string", "format": "date-time"},
        "decision": {"enum": ["BET", "WATCH", "PASS"]},
        "market": {"type": ["string", "null"]},
        "selection": {"type": ["string", "null"]},
        "entry_odds": {"type": ["number", "null"], "exclusiveMinimum": 1},
        "confidence": {"type": ["number", "string"]},
        "rationale": {"type": "string", "minLength": 1},
        "counterargument": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "BET"}}},
          "then": {
            "required": ["market", "selection", "entry_odds"],
            "properties": {
              "market": {"type": "string", "minLength": 1},
              "selection": {"type": "string", "minLength": 1},
              "entry_odds": {"type": "number", "exclusiveMinimum": 1}
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "observed_at", "note"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "url": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"], "format": "date-time"},
          "observed_at": {"type": "string", "format": "date-time"},
          "category": {"type": ["string", "null"]},
          "relationship": {"enum": ["SUPPORTS", "CONTRADICTS", "NEUTRAL", "UNKNOWN"]},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "settlement": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PENDING", "WIN", "LOSS", "VOID", "NO_BET"]},
        "final_score": {"type": ["string", "null"]},
        "ht_score": {"type": ["string", "null"]},
        "closing_odds": {"type": ["number", "null"]},
        "clv": {"type": ["number", "null"]},
        "pnl_units": {"type": ["number", "null"]},
        "roi": {"type": ["number", "null"]},
        "result_source": {"type": ["string", "null"]},
        "result_source_url": {"type": ["string", "null"]},
        "result_observed_at": {"type": ["string", "null"], "format": "date-time"},
        "source_status": {"type": ["string", "null"]},
        "hypothetical_result": {"enum": ["WIN", "LOSS", "VOID", null]},
        "postmortem_class": {"type": ["string", "null"]},
        "postmortem": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["archive_created_at", "source_repo", "source_commit"],
      "properties": {
        "archive_created_at": {"type": "string", "format": "date-time"},
        "archive_finalized_at": {"type": ["string", "null"], "format": "date-time"},
        "source_repo": {"type": "string"},
        "source_commit": {"type": "string"}
      }
    }
  }
}
