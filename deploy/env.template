# SmartXFlow — Hetzner .env Şablonu
# Sunucuda bu dosyayı /opt/smartxflow/.env olarak kaydet
# chmod 600 /opt/smartxflow/.env

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── Fixture Identity V2 ────────────────────────────────────────────────────
# Provider-authoritative DB migration + postflight tamamlanmadan true YAPMA.
# true iken identity hatasi legacy match_id_hash writer'a fallback etmez.
SMARTXFLOW_FIXTURE_UID_AUTHORITATIVE_WRITE=false

# ── Flask ───────────────────────────────────────────────────────────────────
SESSION_SECRET=GUCLU_RASTGELE_BIR_SECRET_BURAYA

# ── Predictor Orchestrator ──────────────────────────────────────────────────
# Predictor LLM output must pass the standalone orchestrator before publication.
# Keep these secrets server-side; never expose them to browser JavaScript.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
PREDICTOR_LLM_MODEL=gpt-6-sol
PREDICTOR_ORCHESTRATOR_SECRET=GUCLU_RASTGELE_INTERNAL_SECRET
PREDICTOR_MAX_ATTEMPTS=3
PREDICTOR_REQUEST_TIMEOUT=120
PREDICTOR_STAGE2_WEB_SEARCH=true
PREDICTOR_MAX_OUTPUT_TOKENS=12000
# Production systemd overrides this to /var/lib/smartxflow-predictor/predictor-orchestrator.sqlite3
PREDICTOR_STATE_DB=data/predictor_orchestrator.sqlite3
PREDICTOR_BIND=127.0.0.1
PREDICTOR_PORT=8011

# ── Telegram ────────────────────────────────────────────────────────────────
PAYMENT_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
PAYMENT_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── API Football ────────────────────────────────────────────────────────────
APIFOOTBALL_KEY=YOUR_APIFOOTBALL_KEY

# ── Betwatch (canlı scraper) ─────────────────────────────────────────────────
BETWATCH_COOKIE=YOUR_BETWATCH_COOKIE_STRING

# ── Excapper (prematch scraper) ──────────────────────────────────────────────
excapper_cookie=YOUR_EXCAPPER_COOKIE_STRING

# ── Deployment mode ──────────────────────────────────────────────────────────
REPL_DEPLOYMENT=1
