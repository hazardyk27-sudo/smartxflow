# SmartXFlow — Hetzner .env Şablonu
# Sunucuda bu dosyayı /opt/smartxflow/.env olarak kaydet
# chmod 600 /opt/smartxflow/.env

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── Fixture Identity V2 ────────────────────────────────────────────────────
# Provider-authoritative DB migration + postflight tamamlanmadan true YAPMA.
# true iken identity hatasi legacy match_id_hash writer'a fallback etmez.
SMARTXFLOW_FIXTURE_UID_AUTHORITATIVE_WRITE=false

# ── Flask / production web ─────────────────────────────────────────────────
# Hetzner production web server-only internal API'leri kaydeder. Scraping yine
# ayri systemd worker'larina aittir; smartxflow-web.service DISABLE_SCRAPER=true
# ile defense-in-depth uygular.
SMARTXFLOW_MODE=server
SESSION_SECRET=GUCLU_RASTGELE_BIR_SECRET_BURAYA

# ── Learning Archive server-to-server API ──────────────────────────────────
# Gercek production secret en az 32 rastgele karakter olmali.
LEARNING_ARCHIVE_ACCESS_SECRET=GUCLU_RASTGELE_LEARNING_ARCHIVE_SECRET
SMARTXFLOW_LEARNING_API_BASE_URL=https://smartxflow.com
# Ayrı client token kullanmak istersen doldur; bos ise ACCESS_SECRET kullanilir.
# SMARTXFLOW_LEARNING_API_TOKEN=OPTIONAL_SEPARATE_CLIENT_TOKEN

# ── Predictor Orchestrator ──────────────────────────────────────────────────
# Predictor LLM output must pass the standalone orchestrator before publication.
# Keep these secrets server-side; never expose them to browser JavaScript.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
PREDICTOR_LLM_MODEL=gpt-6.1-sol
PREDICTOR_ORCHESTRATOR_SECRET=GUCLU_RASTGELE_INTERNAL_SECRET
PREDICTOR_MAX_ATTEMPTS=3
PREDICTOR_REQUEST_TIMEOUT=120
PREDICTOR_STAGE2_WEB_SEARCH=true
PREDICTOR_MAX_OUTPUT_TOKENS=12000
# Production systemd overrides this to /var/lib/smartxflow-predictor/predictor-orchestrator.sqlite3
PREDICTOR_STATE_DB=data/predictor_orchestrator.sqlite3
PREDICTOR_BIND=127.0.0.1
PREDICTOR_PORT=8011

# ── Telegram ────────────────────────────────────────────────────────────────
PAYMENT_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
PAYMENT_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── API Football ────────────────────────────────────────────────────────────
APIFOOTBALL_KEY=YOUR_APIFOOTBALL_KEY

# ── Betwatch ────────────────────────────────────────────────────────────────
# Kodda tarihsel olarak bu exact env adi kullaniliyor; spelling'i degistirme.
Betwach_api_key=YOUR_BETWATCH_API_TOKEN
BETWATCH_COOKIE=YOUR_BETWATCH_COOKIE_STRING

# ── Excapper legacy compatibility ──────────────────────────────────────────
excapper_cookie=YOUR_EXCAPPER_COOKIE_STRING

# ── Deployment mode ─────────────────────────────────────────────────────────
# REPL_DEPLOYMENT SmartXFlow tarafinda halen generic production guard olarak
# kullaniliyor; Replit platformuna bagimlilik anlamina gelmez. Sonraki cleanup'ta
# SMARTXFLOW_PRODUCTION'a tasinacak.
SMARTXFLOW_PRODUCTION=1
REPL_DEPLOYMENT=1
