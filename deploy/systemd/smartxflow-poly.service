[Unit]
Description=SmartXFlow Polymarket Trade Ledger Scraper
After=network-online.target
Wants=network-online.target

[Service]
User=smartxflow
Group=smartxflow
WorkingDirectory=/opt/smartxflow
EnvironmentFile=/opt/smartxflow/.env
ExecStart=/opt/smartxflow/venv/bin/python /opt/smartxflow/poly_runtime.py /opt/smartxflow/polymarket_scraper.py
Restart=always
RestartSec=30
StandardOutput=append:/opt/smartxflow/logs/poly.log
StandardError=append:/opt/smartxflow/logs/poly.log

[Install]
WantedBy=multi-user.target
