[Unit]
Description=SmartXFlow Predictor Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartxflow
Group=smartxflow
WorkingDirectory=/opt/smartxflow
EnvironmentFile=/opt/smartxflow/.env
EnvironmentFile=-/var/lib/smartxflow-predictor/predictor-orchestrator.env
Environment=PREDICTOR_BIND=127.0.0.1
Environment=PREDICTOR_PORT=8011
Environment=PREDICTOR_STATE_DB=/var/lib/smartxflow-predictor/predictor-orchestrator.sqlite3
Environment=LEARNING_ARCHIVE_GIT_SSH_KEY=/var/lib/smartxflow-prematch/github_learning_archive_ed25519
StateDirectory=smartxflow-predictor
StateDirectoryMode=0750
ExecStartPre=/opt/smartxflow/venv/bin/python /opt/smartxflow/scripts/verify_learning_archive_ssh_write.py
ExecStart=/opt/smartxflow/venv/bin/gunicorn predictor_orchestrator.wsgi:app \
    --workers 1 \
    --threads 4 \
    --bind 127.0.0.1:8011 \
    --timeout 180 \
    --graceful-timeout 30 \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/smartxflow-predictor

[Install]
WantedBy=multi-user.target
